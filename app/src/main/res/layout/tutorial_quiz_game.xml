<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/setting_alert_bg"
    android:orientation="vertical"
    android:gravity="center"
    android:paddingHorizontal="30dp"
    >


    <ImageView
        android:id="@+id/stars_user_points"
        android:layout_width="wrap_content"
        android:adjustViewBounds="true"
        android:layout_height="wrap_content"
        android:src="@drawable/stars_3"
        android:layout_gravity="center"
        android:layout_marginTop="10dp"
        />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_finish_tutorial_quiz"
        style="@style/Widget.AppCompat.Button.NoShadow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="15dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/btn_login_bg"
        android:fontFamily="@font/plumpfull"
        android:text="Começar"
        android:textAllCaps="true"
        android:textColor="@color/white"
        android:textSize="20sp" />

</LinearLayout>
